generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://backend_db_user:2512@localhost:5432/backend_db"
  //env("DATABASE_URL")
}

enum ServiceType {
  FREE
  BASIC
  STANDARD
  PREMIUM
}

model Monitors {
  id     String      @id @default(uuid())
  year   Int
  email  String
  duinit String
  owner  String
  type   ServiceType @default(FREE)

  created_at DateTime @default(now())
}
